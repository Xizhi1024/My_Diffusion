        "{root}",
        "--output",
        "{output}",
        "--raw-root",
        "{raw_root}"
      ],
      "decision_file": "decision.json",
      "pass_path": "decision",
      "pass_value": "PASS",
      "contract_path": "dataset_contract_sha256",
      "requires": [
        "00A_data_audit"
      ]
