{
  "schema_version": 1,
  "pipeline_id": "ct_pet_residual_brownian_bridge_mechanism_v1",
  "policy": {
    "ordering": "falsify_before_implementation",
    "patient_unit_required": true,
    "threshold_sources": [
      "mechanism_train",
      "calibration"
    ],
    "validation_or_test_driven_training_forbidden": true,
    "patient_bootstrap_95ci_required": true,
    "correlation_is_not_causality_or_mutual_information": true,
    "failed_gate_stops_dependent_stages": true,
    "decision_json_required_per_stage": true,
    "unverified_checkpoint_forbidden": true
  },
  "decision_profiles": {
    "model_mechanism": {
      "required_assertions": {
        "guardrails.patient_unit": "patient",
        "guardrails.threshold_source": "mechanism_train_and_calibration_only",
        "guardrails.validation_or_test_drives_training_or_course": false,
        "guardrails.patient_bootstrap_95ci": true,
        "guardrails.causal_or_mutual_information_claimed": false,
        "guardrails.checkpoint_lineage": "PASS"
      }
    }
  },
  "stages": [
    {
      "id": "00A_data_audit",
      "title": "Stage 0A local raw-data gate",
      "hypothesis": "DATA",
      "scopes": [
        "local",
        "all"
      ],
      "implemented": true,
      "output": "results/mechanism_validation/00_data_audit",
      "command": [
        "{python}",
        "scripts/run_mechanism_stage0_data_audit.py",
        "--root",
        "{root}",
        "--output",
        "{output}",
        "--raw-root",
        "{raw_root}",
        "--locked-contract",
        "{contract}",
        "--skip-checkpoint-inventory"
      ],
      "decision_file": "decision.json",
      "pass_path": "data_gate",
      "pass_value": "PASS",
      "contract_path": "dataset_contract_sha256",
      "requires": []
    },
    {
      "id": "00B_h1_spectral_asymmetry",
      "title": "H1 CT support / PET amplitude spectral asymmetry",
      "hypothesis": "H1",
      "scopes": [
